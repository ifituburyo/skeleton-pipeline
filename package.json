{
  "name": "ar-anatomy-visualizer",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based AR anatomy visualiser: live pose estimation + illustrative 3D skeleton overlay (educational / research MVP, not an X-ray).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-mediapipe-wasm.mjs",
    "fetch-models": "node scripts/fetch-models.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.0",
    "playwright": "^1.63.0",
    "typescript": "~5.9.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
